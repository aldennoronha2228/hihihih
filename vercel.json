{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend/vercel_app.py",
      "functions": {
        "backend/vercel_app.py": {
          "includeFiles": "{backend/catalog/**,backend/templates/**,vendor/velxio/frontend/public/components-metadata.json}",
          "excludeFiles": "{node_modules/**,vendor/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
