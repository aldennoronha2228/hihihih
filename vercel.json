{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "vercel_app.py",
      "installCommand": "pip install -r requirements-vercel.txt",
      "functions": {
        "vercel_app.py": {
          "includeFiles": "{catalog/**,templates/**}",
          "excludeFiles": "{tests/**,data/**,builds/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
