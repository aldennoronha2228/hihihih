  "cards": [
    {
      "dot": "cyan",
      "title": "Entry and orchestration",
      "items": [
        "Vite serves the SPA and proxies /api plus WebSockets to FastAPI.",
        "FastAPI streams chat events as NDJSON and mounts hardware, sample, and security routers.",
        "SecurityMiddleware enforces loopback-only access, CORS, request-body caps, and concurrent-request budget (new)."
      ]
    },
    {
      "dot": "emerald",
      "title": "Feasibility engine (new)",
      "items": [
        "assess() analyses an agent plan and returns a risk report before any destructive tool call.",
        "authorize() records user consent against a plan assessment ID.",
        "check_operation() gates each individual tool invocation — the agent cannot proceed without a valid approval token."
      ]
    },
    {
      "dot": "amber",
      "title": "Circuit wiring (new)",
      "items": [
        "validate_circuit() enforces electrical rules: power-rail types, GPIO conflicts, missing grounds.",
        "wire_circuit() is an agent tool that validates and writes the connection list back into the project JSON.",
        "Wiring runs before compilation to catch layout errors early."
      ]
    },
    {
      "dot": "violet",
      "title": "Execution modes",
      "items": [
        "Arduino CLI produces temporary firmware artifacts.",
        "AVR and RP2040 boards execute in-browser via avr8js / rp2040js.",
        "ESP32 boards (devkit-v1, devkit-c-v4, S3, C3) route to the remote simulation server via RemoteSimulationClient (new)."
      ]
    },
    {
      "dot": "rose",
      "title": "Production deployment (new)",
      "items": [
        "local-production: Docker Compose stack — single unified image with Caddy TLS ingress.",
        "remote-simulation: standalone emulator Docker Compose with Nginx ingress, independently deployable.",
        "Both stacks ship Dockerfiles and smoke tests."
      ]
    }
  ]
}
