  "code": "const uint8_t TRIG_PIN = 2;\nconst uint8_t ECHO_PIN = 3;\nconst uint8_t LEFT_ENABLE = 5;\nconst uint8_t RIGHT_ENABLE = 6;\nconst uint8_t LEFT_IN1 = 7;\nconst uint8_t LEFT_IN2 = 8;\nconst uint8_t RIGHT_IN1 = 9;\nconst uint8_t RIGHT_IN2 = 10;\nconst uint8_t DRIVE_PWM = 120;\nconst unsigned long ECHO_TIMEOUT_US = 30000UL;\nconst long STOP_DISTANCE_CM = 25;\n\nvoid setDrive(int left, int right) {\n  digitalWrite(LEFT_IN1, left >= 0 ? HIGH : LOW);\n  digitalWrite(LEFT_IN2, left >= 0 ? LOW : HIGH);\n  digitalWrite(RIGHT_IN1, right >= 0 ? HIGH : LOW);\n  digitalWrite(RIGHT_IN2, right >= 0 ? LOW : HIGH);\n  analogWrite(LEFT_ENABLE, abs(left));\n  analogWrite(RIGHT_ENABLE, abs(right));\n}\n\nvoid stopDrive() {\n  analogWrite(LEFT_ENABLE, 0);\n  analogWrite(RIGHT_ENABLE, 0);\n}\n\nlong readDistanceCm() {\n  digitalWrite(TRIG_PIN, LOW);\n  delayMicroseconds(2);\n  digitalWrite(TRIG_PIN, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(TRIG_PIN, LOW);\n  const unsigned long echoUs = pulseIn(ECHO_PIN, HIGH, ECHO_TIMEOUT_US);\n  if (echoUs == 0) return -1;\n  return static_cast<long>(echoUs / 58UL);\n}\n\nvoid setup() {\n  pinMode(TRIG_PIN, OUTPUT);\n  pinMode(ECHO_PIN, INPUT);\n  pinMode(LEFT_ENABLE, OUTPUT);\n  pinMode(RIGHT_ENABLE, OUTPUT);\n  pinMode(LEFT_IN1, OUTPUT);\n  pinMode(LEFT_IN2, OUTPUT);\n  pinMode(RIGHT_IN1, OUTPUT);\n  pinMode(RIGHT_IN2, OUTPUT);\n  stopDrive();\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  const long distanceCm = readDistanceCm();\n  if (distanceCm < 0) {\n    stopDrive();\n    Serial.println(\"ultrasonic_timeout; drive stopped\");\n    delay(60);\n    return;\n  }\n\n  Serial.print(\"distance_cm=\");\n  Serial.println(distanceCm);\n  if (distanceCm <= STOP_DISTANCE_CM) {\n    stopDrive();\n    delay(100);\n    setDrive(-DRIVE_PWM, -DRIVE_PWM);\n    delay(250);\n    setDrive(-DRIVE_PWM, DRIVE_PWM);\n    delay(350);\n    stopDrive();\n  } else {\n    setDrive(DRIVE_PWM, DRIVE_PWM);\n    delay(60);\n  }\n}"
}
